# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Originais do ensaio fotográfico (62 MB). Só os derivados otimizados de
# public/portrait/ entram no repositório.
/assets

# Notas de trabalho, so minhas. O repositorio e publico, e elas carregam
# raciocinio interno, caminhos desta maquina e nomes de projeto que nao
# aparecem no site.
/memory
